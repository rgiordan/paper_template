<<setup, include=FALSE, cache=FALSE>>=
knitr_debug <- FALSE # Set to true to see error output

rerun_all <- TRUE

# Set to true to cache knitr output for this analysis.
cache <- TRUE && (!rerun_all)


source("figures_knitr/initialize.R", echo=FALSE)
@

<<load_data>>=
source(file.path(script_path, "load_data.R"))

@

\newcommand{\DefineMacros}{
<<define_macros, results="asis">>=
source(file.path(script_path, "define_macros.R"))
@
}


%%%%%%%%%%%%%%%%%%%%%%%

\newcommand{\ExamplePlot}{
<<>>=
figcap <- paste0("Caption  here")
@
<<exampleplot, cache=cache, fig.show='hold', fig.cap=figcap, fig.pos="h!", fig.scap="">>=
source(file.path(script_path, "example_graph.R"), print.eval=TRUE)
@
}



% %%%%%%%%%%%%%%%%%%%%%%

\newcommand{\ExampleTable}{
<<exampletable, cache=cache, results='asis', echo=FALSE>>=
source(file.path(script_path, "example_table.R"), print.eval=TRUE)
@
}
